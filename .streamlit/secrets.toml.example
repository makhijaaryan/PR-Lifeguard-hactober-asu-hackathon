# Copy to .streamlit/secrets.toml and fill in. Never commit the real file.
[snowflake]
account = "your_org-your_account"
user = "YOUR_USER"
api_key = "your_programmatic_access_token"
role = "YOUR_ROLE"
host = "your_org-your_account.snowflakecomputing.com"
warehouse = "YOUR_WAREHOUSE"
database = "YOUR_DATABASE"
schema = "YOUR_SCHEMA"
model = "llama3.1-70b"
fallback_model = "mistral-large2"

[github]
token = "ghp_your_github_token"
